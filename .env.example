# Uso en tu ordenador: no necesitas copiar ni cargar este archivo.
# app.py utiliza estos valores por defecto. No carga archivos .env automáticamente.
ALGYRE_MODE=local
ALGYRE_PORT=8765
# Los datos se guardan en data/, junto al programa.

# Solo para instalar un servidor propio: consulta deploy/LEEME.md.
# install-debian.sh crea la configuración y genera su clave en el servidor.
# ALGYRE_MODE=public
# ALGYRE_PUBLIC_URL=https://IP_PUBLICA_DE_TU_SERVIDOR
# ALGYRE_DATA_DIR=/var/lib/algyre
# ALGYRE_SECRET_KEY=
# ALGYRE_PORT=8766
# ALGYRE_OPERATOR_NAME=
# ALGYRE_OPERATOR_EMAIL=
# ALGYRE_SMTP_HOST=
# ALGYRE_SMTP_PORT=587
# ALGYRE_SMTP_USER=
# ALGYRE_SMTP_PASSWORD=
# ALGYRE_MAIL_FROM=

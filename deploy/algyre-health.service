[Unit]
Description=Comprobar HTTPS y disponibilidad de ALgyre
After=apache2.service algyre.service

[Service]
Type=oneshot
User=algyre
Group=algyre
EnvironmentFile=/etc/algyre.env
ExecStart=/bin/bash /opt/algyre/deploy/health.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
